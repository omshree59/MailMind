# Copy to .env and fill in the Google values. Never commit .env.

# Local Ollama. MailMind will not call a cloud model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Must match a name from `ollama list`. This machine currently has gemma3:4b.
OLLAMA_MODEL=gemma3:4b

# Previous calendar day is computed in this timezone. Scheduling uses it too.
REPORT_TIMEZONE=Asia/Kolkata
REPORT_HOUR=7
REPORT_MINUTE=0
# true = run daily automation automatically once Google is connected.
SCHEDULE_ENABLED=true
# auto = automatically run missed daily reports on startup or wake.
REPORT_CATCHUP=auto

# Drive folder ID to receive date-wise report folders.
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
# full = broader Drive scope for an existing folder; file = drive.file scope.
GOOGLE_DRIVE_ACCESS=full

# Google Cloud OAuth client (Web application).
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/oauth/callback

PORT=8787
DATA_DIR=./data
GMAIL_MAX_MESSAGES=300
TEST_EMAIL_LIMIT=3
OLLAMA_NETWORK_RETRIES=2
OLLAMA_INVALID_RETRIES=2
